# Production secrets/config for docker-compose.prod.yml.
# Copy to `.env` (compose auto-loads it) and fill in. Keep this file out of git.
#
# docs/prod-env.example.txt is the same template with fuller commentary on each
# value (rotation caveats, how to generate them) — read that one first if you
# are deploying for the first time. Every REQUIRED var below must appear in
# BOTH files; they are the same contract.
#
# The four REQUIRED vars are declared as ${VAR:?} in docker-compose.prod.yml, so
# Compose ABORTS rather than deploying a publicly-known dev default. Even
# `build` and `config` need them interpolated.

# REQUIRED — a long random string. Anyone who knows it can forge auth tokens.
#   generate: openssl rand -base64 48
JWT_SECRET=

# ----- REQUIRED: datastore credentials -----
# The base compose ships dev defaults that are committed to a public repo, so
# prod must override them. The backend's DATABASE_URL / MINIO_ACCESS_KEY /
# MINIO_SECRET_KEY interpolate these SAME variables — setting them here rotates
# the server and its client together, so don't configure the backend separately.
#   generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# Avoid the literal `minioadmin` — it is the first value any scanner tries.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# WARNING — rotating on an EXISTING deployment: POSTGRES_PASSWORD only takes
# effect when the Postgres data volume is first initialised. Changing it on a
# stack that has already run will not change the password inside the database,
# and the backend will fail to connect. Use an in-DB `ALTER USER` (or dump and
# restore) instead. Same applies to the MinIO root credentials.

# ----- Email (optional) -----
# Default uses docker-mailserver (run with `--profile mail`). To use an external
# relay instead, set these and skip the mail profile:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=...
SMTP_FROM=Uploader <no-reply@rabbitworld.ddns.net>
MAIL_HOSTNAME=mail.rabbitworld.ddns.net

# ----- Web Push (Task5 #7) -----
# Generate once: npx web-push generate-vapid-keys
# Leave empty to disable push in prod (the base compose ships DEV keys, which
# prod overrides to empty unless you set real ones here).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@rabbitworld.ddns.net
