# Production secrets/config for docker-compose.prod.yml.
# Copy to `.env` (compose auto-loads it) and fill in. Keep this file out of git.

# REQUIRED — a long random string. Anyone who knows it can forge auth tokens.
#   generate: openssl rand -base64 48
JWT_SECRET=

# ----- Email (optional) -----
# Default uses docker-mailserver (run with `--profile mail`). To use an external
# relay instead, set these and skip the mail profile:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=...
SMTP_FROM=Uploader <no-reply@rabbitworld.ddns.net>
MAIL_HOSTNAME=mail.rabbitworld.ddns.net

# ----- Recommended: change the default infra credentials -----
# These also need updating in docker-compose.yml (postgres + minio services and
# DATABASE_URL) if you change them — keep them in sync.
#   POSTGRES_PASSWORD / MINIO_ROOT_PASSWORD
