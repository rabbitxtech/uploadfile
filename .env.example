# ===== Database =====
# Provider: postgresql | mysql | sqlite
DB_PROVIDER=postgresql
# For postgres: postgresql://user:pass@host:5432/dbname
# For mysql:    mysql://user:pass@host:3306/dbname
# For sqlite:   file:./dev.db
DATABASE_URL=postgresql://uploader:uploader@localhost:5432/uploader

# ===== MinIO =====
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uploads
# Public endpoint that the browser can reach (for presigned URLs)
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# ===== Backend =====
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:4000
DEFAULT_QUOTA_BYTES=5368709120
# Auto-purge items left in trash longer than this many days (0 disables).
TRASH_RETENTION_DAYS=30

# ===== Email (B9 — password reset / verify) =====
# Leave SMTP_HOST empty to disable sending (reset links are printed to the log).
# With docker compose, Mailpit catches mail: SMTP_HOST=mailpit, view at :8025.
# For real delivery use a relay (e.g. Gmail/SendGrid) and set SMTP_SECURE/USER/PASS.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Uploader <no-reply@uploader.local>
# Base URL used to build links inside emails (must be browser-reachable).
PUBLIC_APP_URL=http://localhost:8080

# ===== Frontend =====
VITE_API_BASE=http://localhost:4000
