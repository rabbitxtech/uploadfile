# ===== Database =====
# Provider: postgresql | mysql | sqlite
DB_PROVIDER=postgresql
# For postgres: postgresql://user:pass@host:5432/dbname
# For mysql:    mysql://user:pass@host:3306/dbname
# For sqlite:   file:./dev.db
DATABASE_URL=postgresql://uploader:uploader@localhost:5432/uploader

# ===== MinIO =====
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uploads
# Public endpoint that the browser can reach (for presigned URLs)
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# ===== Backend =====
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:4000
DEFAULT_QUOTA_BYTES=5368709120
# Auto-purge items left in trash longer than this many days (0 disables).
TRASH_RETENTION_DAYS=30
# Feature flag: set false to temporarily lock ZIP download (bulk + folder share).
ZIP_DOWNLOAD_ENABLED=true
# Video import (yt-dlp): extra allowed source domains (comma-separated) on top of
# the built-in list (YouTube, Vimeo, Dailymotion, TED, archive.org, …).
VIDEO_IMPORT_HOSTS=

# ===== Task5 #9 — HLS adaptive streaming (opt-in, CPU-heavy) =====
# Transcode uploaded videos to 720p/480p HLS in the background; the player
# switches quality automatically. Only videos >= HLS_MIN_MB are transcoded.
HLS_ENABLED=false
HLS_MIN_MB=50

# ===== Task5 #10 — Whisper transcription (opt-in, CPU-heavy) =====
# Auto-transcribe video/audio with whisper.cpp: creates a .vtt subtitle file
# next to the media and makes the transcript searchable. Model (~150 MB for
# "base") downloads on first use into the models volume. WHISPER_LANG=auto
# detects the language (vi/en both work); models: tiny|base|small|medium.
WHISPER_ENABLED=false
WHISPER_MODEL=base
WHISPER_LANG=auto

# ===== Task5 #7 — Web Push notifications (PWA) =====
# Generate a keypair once with `npx web-push generate-vapid-keys`. Push is a
# no-op unless BOTH keys are set. Subject is a mailto:/https: contact URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ===== Abuse / quota caps (Task 15 — 0 = unlimited) =====
# Max active share links / API keys a single user may own (admins exempt).
MAX_SHARES_PER_USER=200
MAX_API_KEYS_PER_USER=25
# Drop-box (anonymous upload link) anti-abuse: total uploads accepted per link,
# and max size of one anonymous upload in bytes (0 = use global 100 MB limit).
DROPBOX_MAX_UPLOADS_PER_SHARE=50
DROPBOX_MAX_FILE_BYTES=0
# Throttle authenticated downloads to N KB/s per connection (0 = unlimited).
DOWNLOAD_BANDWIDTH_KBPS=0

# ===== Email (B9 — password reset / verify) =====
# Leave SMTP_HOST empty to disable sending (reset links are printed to the log).
# With docker compose, Mailpit catches mail: SMTP_HOST=mailpit, view at :8025.
# For real delivery use a relay (e.g. Gmail/SendGrid) and set SMTP_SECURE/USER/PASS.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Uploader <no-reply@uploader.local>
# Base URL used to build links inside emails (must be browser-reachable).
PUBLIC_APP_URL=http://localhost:8080

# ===== Frontend =====
VITE_API_BASE=http://localhost:4000
